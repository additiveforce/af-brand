{
  "meta": {
    "name": "AF Typography",
    "version": "2.0",
    "scope": "One family, Geist. Sizes are web values at 1440 wide; decks and documents keep the same roles."
  },
  "family": "Geist",
  "fallback": [
    "system-ui",
    "sans-serif"
  ],
  "styles": {
    "screen": {
      "size": "191px",
      "lineHeight": "167px",
      "weight": 900,
      "tracking": "-0.03em",
      "case": "capitals",
      "usedFor": "Homepage folds. Geist Black, uppercase. One size on every fold, set so the longest word (INTELLIGENCE) fills the grid width"
    },
    "figure": {
      "size": "96px",
      "lineHeight": "86.4px",
      "weight": 600,
      "tracking": "-0.045em",
      "case": "sentence",
      "usedFor": "Result figures and key numbers. Tabular numerals"
    },
    "display": {
      "size": "64px",
      "lineHeight": "65.28px",
      "weight": 600,
      "tracking": "-0.035em",
      "case": "sentence",
      "usedFor": "Page H1. Once per page"
    },
    "head": {
      "size": "24px",
      "lineHeight": "30px",
      "weight": 400,
      "tracking": "-0.015em",
      "case": "sentence",
      "usedFor": "Ledes, quotes and the next-case link"
    },
    "head-strong": {
      "size": "24px",
      "lineHeight": "30px",
      "weight": 600,
      "tracking": "-0.015em",
      "case": "sentence",
      "usedFor": "Section lines and pull lines"
    },
    "body": {
      "size": "16px",
      "lineHeight": "25.6px",
      "weight": 400,
      "tracking": "0em",
      "case": "sentence",
      "usedFor": "Body text"
    },
    "body-strong": {
      "size": "16px",
      "lineHeight": "25.6px",
      "weight": 600,
      "tracking": "0em",
      "case": "sentence",
      "usedFor": "Text headings, nav links, names"
    },
    "nav": {
      "size": "16px",
      "lineHeight": "25.6px",
      "weight": 500,
      "tracking": "0em",
      "case": "sentence",
      "usedFor": "Nav links and the descriptor. Medium, the one exception to 400 and 600: 600 reads heavy in a browser"
    },
    "small": {
      "size": "13px",
      "lineHeight": "18.85px",
      "weight": 400,
      "tracking": "0em",
      "case": "sentence",
      "usedFor": "Captions, metadata, chart text"
    },
    "small-strong": {
      "size": "13px",
      "lineHeight": "18.85px",
      "weight": 600,
      "tracking": "0em",
      "case": "sentence",
      "usedFor": "Labels. Sentence case"
    }
  }
}
