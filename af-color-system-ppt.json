{
  "meta": {
    "name": "AF Color System — PowerPoint",
    "document_id": "af-color-system-ppt",
    "version": "2026",
    "last_reviewed": "2026-Q1",
    "scope": "Presentations only. These are the exact colour values generated by PowerPoint's theme engine from the Additive Force theme file. Do not apply to non-PPT outputs — use af-color-system.json for web, documents, and HTML reports.",
    "does_not_cover": "Non-PPT colour tokens — those are in af-color-system.json. These two files are permanently separate and must never be cross-applied.",
    "accuracy_note": "Hex values were extracted via eyedropper from the PPT theme panel. Single-digit drift is possible across the stack. Deep Indigo values have been manually verified and corrected. Other colours are accurate to within eyedropper tolerance.",
    "theme_order": ["Pure-White-PPT", "Deep-Indigo-PPT", "Gallery-White", "Charcoal-PPT", "Primary-Blue-PPT", "Classic-Red-PPT", "Amber-PPT", "Jade-PPT", "Teal-PPT", "Violet-PPT"]
  },
  "usage_rules": [
    "All PPTX colour references use tokens from this file, not af-color-system.json",
    "Neutrals are for backgrounds and text",
    "Primary Blue is used intentionally, not decoratively",
    "Secondary colours are used selectively — only when necessary, as few as possible",
    "When a secondary colour is needed for data series: prefer a corresponding neutral tint/shade first. Use a secondary only when neutral range is genuinely insufficient"
  ],
